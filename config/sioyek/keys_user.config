# Vim Navigation
move_down           j
move_up             k
move_left           h
move_right          l

next_page           J
previous_page       K
goto_begining       gg
goto_end            G

# Zoom & Fit
zoom_in             =
zoom_out            -
fit_to_page_width   w
fit_to_page_height  e

# Actions
toggle_dark_mode    d
open_document       o
search              /
