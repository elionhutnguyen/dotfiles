# Color Theme: Dark Mode (Catppuccin Mocha inspired)
background_color        0.12 0.12 0.18
dark_mode_background_color 0.12 0.12 0.18
dark_mode_contrast      0.85
text_highlight_color    0.95 0.85 0.45
search_highlight_color  0.40 0.80 0.85

# Behavior
default_dark_mode       1
fit_page_to_width_on_open 1
wheel_scroll_multiplier 1.5

# Visuals
font_size               15
status_bar_font_size    14
status_bar_color        0.18 0.18 0.24
status_bar_text_color   0.90 0.90 0.95
